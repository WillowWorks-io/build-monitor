<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.willowworks.build-monitor</string>

  <!-- Edit both paths to match where the repo lives. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/CHANGEME/git/github/willowworks.io/build-monitor/build-monitor</string>
    <string>-config</string>
    <string>/Users/CHANGEME/git/github/willowworks.io/build-monitor/config.yaml</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/CHANGEME/git/github/willowworks.io/build-monitor</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/build-monitor.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/build-monitor.err</string>
</dict>
</plist>
